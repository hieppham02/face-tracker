/* USER CODE END PTD */

/* Private define ------------------------------------------------------------*/
/* USER CODE BEGIN PD */
#define JOY_X_MIN      3
#define JOY_X_CENTER   2000
#define JOY_X_MAX      4095

#define JOY_Y_MIN      3
#define JOY_Y_CENTER   2000
#define JOY_Y_MAX      4095

#define DEAD_ZONE       250
#define SERVO_UPDATE_MS 15

#define MAX_STEP_X10    30

#define PAN_POS_GAIN    100
#define PAN_NEG_GAIN    100

#define TILT_POS_GAIN   100
#define TILT_NEG_GAIN   100
/* USER CODE END PD */

/* Private macro -------------------------------------------------------------*/
/* USER CODE BEGIN PM */

/* USER CODE END PM */

/* Private variables ---------------------------------------------------------*/
ADC_HandleTypeDef hadc1;
DMA_HandleTypeDef hdma_adc1;

TIM_HandleTypeDef htim2;
TIM_HandleTypeDef htim3;

UART_HandleTypeDef huart1;

/* USER CODE BEGIN PV */

/* USER CODE END PV */

/* Private function prototypes -----------------------------------------------*/
void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_DMA_Init(void);
static void MX_TIM3_Init(void);
static void MX_TIM2_Init(void);
static void MX_USART1_UART_Init(void);
static void MX_ADC1_Init(void);
/* USER CODE BEGIN PFP */

/* USER CODE END PFP */

/* Private user code ---------------------------------------------------------*/
/* USER CODE BEGIN 0 */
volatile uint16_t adc_value[2];

uint8_t rx_byte;
char rx_buffer[20];
uint8_t rx_index = 0;

void Servo_1_SetAngle(uint16_t angle)
{
	if(angle > 180) angle = 180;
    uint16_t pulse;
    pulse = 500 + (angle * 2000) / 180;
    htim3.Instance->CCR4 = pulse;
}

void Servo_2_SetAngle(uint16_t angle)
{
	if(angle > 180) angle = 180;
    uint16_t pulse;
    pulse = 500 + (angle * 2000) / 180;
    htim3.Instance->CCR2 = pulse;
}

void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart)
{
    if (huart->Instance == USART1)
    {
			if (rx_byte == '\n')
			{
				rx_buffer[rx_index] = '\0';

				uint16_t angle = atoi(rx_buffer);

				if (angle <= 180)
				{
						Servo_1_SetAngle(angle);
				}

				rx_index = 0;
			}
			else if (rx_byte != '\r')
			{
				if (rx_index < sizeof(rx_buffer) - 1)
				{
						rx_buffer[rx_index++] = rx_byte;
				}
			}

			HAL_UART_Receive_IT(&huart1, &rx_byte, 1);
    }
}
/* USER CODE END 0 */

/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_DMA_Init();
  MX_TIM3_Init();
  MX_TIM2_Init();
  MX_USART1_UART_Init();
  MX_ADC1_Init();
  /* USER CODE BEGIN 2 */
	HAL_ADCEx_Calibration_Start(&hadc1);
	HAL_ADC_Start_DMA(&hadc1, (uint32_t *)adc_value, 2);
	
	HAL_TIM_PWM_Start(&htim3, TIM_CHANNEL_2);
	HAL_TIM_PWM_Start(&htim3, TIM_CHANNEL_4);
	
	HAL_UART_Receive_IT(&huart1, &rx_byte, 1);
	/*
	Servo_1_SetAngle(0);
	HAL_Delay(1000);
	Servo_1_SetAngle(180);
	HAL_Delay(1000);
	Servo_1_SetAngle(90);
	HAL_Delay(1000);
	*/
	int32_t pan_angle = 90;
	int32_t	tilt_angle = 90;
	uint32_t last_update = 0;
	int32_t pan_accum = 0;
	int32_t tilt_accum = 0;
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {	
		int32_t joy_x = adc_value[0];
    int32_t joy_y = adc_value[1];

    if (HAL_GetTick() - last_update >= SERVO_UPDATE_MS)
    {
			last_update = HAL_GetTick();

			int32_t error_x = joy_x - JOY_X_CENTER;
			int32_t error_y = joy_y - JOY_Y_CENTER;

			if (error_x > DEAD_ZONE)
			{
					int32_t range = JOY_X_MAX - JOY_X_CENTER - DEAD_ZONE;
					int32_t speed10 = 10 + ((error_x - DEAD_ZONE) * (MAX_STEP_X10 - 10)) / range;

					speed10 = speed10 * PAN_POS_GAIN / 100;
					pan_accum += speed10;
				
					int32_t step = pan_accum / 10;
					pan_accum %= 10;
					pan_angle += step;

					if (pan_angle > 180) pan_angle = 180;
			}
			else if (error_x < -DEAD_ZONE)
			{
					int32_t range = JOY_X_CENTER - JOY_X_MIN - DEAD_ZONE;
					int32_t speed10 = 10 + (((-error_x) - DEAD_ZONE) * (MAX_STEP_X10 - 10)) / range;

					speed10 = speed10 * PAN_NEG_GAIN / 100;
					pan_accum += speed10;
				
					int32_t step = pan_accum / 10;
					pan_accum %= 10;
					pan_angle -= step;
				
					if (pan_angle < 0) pan_angle = 0;
			}
			else
			{
					pan_accum = 0;
			}


			if (error_y > DEAD_ZONE)
			{
					int32_t range = JOY_Y_MAX - JOY_Y_CENTER - DEAD_ZONE;
					int32_t speed10 = 10 + ((error_y - DEAD_ZONE) * (MAX_STEP_X10 - 10)) / range;

					speed10 = speed10 * TILT_POS_GAIN / 100;
					tilt_accum += speed10;
				
					int32_t step = tilt_accum / 10;
					tilt_accum %= 10;
					tilt_angle += step;

					if (tilt_angle > 180) tilt_angle = 180;
			}
			else if (error_y < -DEAD_ZONE)
			{
					int32_t range = JOY_Y_CENTER - JOY_Y_MIN - DEAD_ZONE;
					int32_t speed10 = 10 + (((-error_y) - DEAD_ZONE) * (MAX_STEP_X10 - 10)) / range;

					speed10 = speed10 * TILT_NEG_GAIN / 100;
					tilt_accum += speed10;
				
					int32_t step = tilt_accum / 10;
					tilt_accum %= 10;
					tilt_angle -= step;

					if (tilt_angle < 0) tilt_angle = 0;
			}
			else
			{
					tilt_accum = 0;
			}

			Servo_1_SetAngle(pan_angle);
        Servo_2_SetAngle(tilt_angle);
    }
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

